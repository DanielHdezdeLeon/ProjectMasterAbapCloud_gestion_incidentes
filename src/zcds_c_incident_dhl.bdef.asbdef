projection;
strict ( 2 );
use draft;

define behavior for ZCDS_C_INCIDENT_DHL //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Change_Status;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use association _History { create; with draft; }
}

define behavior for ZCDS_C_INCT_H_DHL //alias <alias_name>
{
//  use update;
//  use delete;

  use association _Incident { with draft; }
}