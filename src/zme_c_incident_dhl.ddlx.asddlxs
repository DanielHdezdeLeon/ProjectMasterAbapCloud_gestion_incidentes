// DHL: Metadata Extension con las anotaciones de UI (Fiori Elements) para la entidad de consumo de incidentes.
// DHL: Capa CUSTOMER: permite sobrescribir metadatos de capas inferiores.
@Metadata.layer: #CUSTOMER

// DHL: Cabecera del objeto: nombre singular/plural, título (Title) y descripción (Description).
@UI.headerInfo: {
  typeName: 'Incident',
  typeNamePlural: 'Incidents',
  title: {
    type: #STANDARD,
    value: 'Title'
  },
  description: {
    type: #STANDARD,
    value: 'Description'
  }
}

annotate entity ZCDS_C_INCIDENT_DHL with
{
  // DHL: Facetas (secciones) de la página de objeto: 'Details' con los datos del incidente
  // y 'History' con la tabla del histórico (asociación _History).
  @UI.facet: [
    {
      id: 'Details',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Details',
      position: 10
    },
    {
      id: 'History',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'History',
      position: 20,
      targetElement: '_History'
    }
  ]


  // DHL: Campo clave técnico (UUID): se oculta, y se usa para colgar el botón 'Change Status'
  // (acción Change_Status) en la página de detalle y en la lista.
  @UI.identification: [
    {
  position: 10,
  type: #FOR_ACTION,
  dataAction: 'Change_Status',
  label: 'Change Status'
  }
  ]
  @UI.lineItem: [
   {
     position: 10,
     type: #FOR_ACTION,
     dataAction: 'Change_Status',
     label: 'Change Status'
  }]
  @UI.hidden: true

  IncUuid;

  // DHL: ID del incidente: visible en detalle y lista, usado como campo de filtro y como objeto semántico para navegación.
  @Consumption.semanticObject: 'Incident'
  // DHL: Título del incidente: visible en detalle y lista, y campo de filtro.
  @UI.identification: [
    {
      position: 10,
      label: 'Incident ID'
    }
  ]
  @UI.lineItem: [
    {
      position: 10,
      label: 'Incident ID'
    }
  ]
  @UI.selectionField: [
    {
      position: 10
    }
  ]
  IncidentId;

  // DHL: Descripción del incidente: solo se muestra en el detalle.
  @UI.identification: [
    {
      position: 20,
      label: 'Title'
    }
  ]
  @UI.lineItem: [
    {
      position: 20,
      label: 'Title'
    }
  ]
  @UI.selectionField: [
    {
      position: 20
    }
  ]
  Title;

  // DHL: Estado: visible en detalle y lista, filtro y ayuda de búsqueda sobre el catálogo ZCDS_I_STATUS_DHL
  // (el valor se valida contra ella).
  @UI.identification: [
    {
      position: 30,
      label: 'Description'
    }
  ]
  Description;

  // DHL: Prioridad: visible en detalle y lista, filtro y ayuda de búsqueda sobre ZCDS_I_PRIORITY_DHL
  // (el valor se valida contra ella).
  @UI.identification: [
    {
      position: 40,
      label: 'Status'
    }
  ]
  @UI.lineItem: [
    {
      position: 40,
      label: 'Status'
    }
  ]
  @UI.selectionField: [
    {
      position: 40
    }
  ]
  @Consumption.valueHelpDefinition: [{
  entity: {
  name: 'ZCDS_I_STATUS_DHL',
  element: 'StatusCode'
  },
  useForValidation : true } ]
  Status;

  // DHL: Fecha de creación: visible en detalle y lista, y campo de filtro.
  @UI.identification: [
    {
      position: 50,
      label: 'Priority'
    }
  ]
  @UI.lineItem: [
    {
      position: 50,
      label: 'Priority'
    }
  ]
  @UI.selectionField: [
    {
      position: 50
    }
  ]
  @Consumption.valueHelpDefinition: [{
    entity: {
    name: 'ZCDS_I_PRIORITY_DHL',
    element: 'PriorityCode'
    },
  useForValidation : true } ]
  Priority;

  // DHL: Fecha de última modificación: solo se muestra en el detalle.
  @UI.identification: [
    {
      position: 60,
      label: 'Creation Date'
    }
  ]
  // DHL: Usuario creador: se muestra en la lista.
  @UI.lineItem: [
    {
      position: 60,
      label: 'Creation Date'
    }
  ]
  @UI.selectionField: [
    {
      position: 60
    }
  ]
  CreationDate;

  @UI.identification: [
    {
      position: 70,
      label: 'Changed On'
    }
  ]
  ChangedDate;

  @UI.lineItem: [
    {
      position: 60,
      label: 'Created By'
    }
  ]
  LocalCreatedBy;

  // DHL: Campos técnicos de auditoría: se ocultan en la interfaz.
  @UI.hidden: true
  LocalCreatedAt;

  @UI.hidden: true
  LocalLastChangedBy;

  @UI.hidden: true
  LocalLastChangedAt;

  @UI.hidden: true
  LastChangedAt;
}